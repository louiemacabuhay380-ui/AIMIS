# Copy this file to .env and fill in your own values. NEVER push .env to GitHub.

# --- Flask
SECRET_KEY=change-me-to-a-long-random-text
# FLASK_DEBUG=1                 # only on your own laptop while coding; never at the defense

# --- MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=aimis

# --- Google Gemini (speech-to-text, scoring, question writing)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=        # optional second Gemini model when the first reaches its limit

# --- Voice recordings (each PC keeps ITS OWN key; recordings can't be played without it)
# Make one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUDIO_ENCRYPTION_KEY=
RECORDING_RETENTION_DAYS=30

# --- Forgot password emails (Gmail App Password, not your real password)
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Local AI with Ollama (chatbot + backup scoring)
CHAT_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
# CHAT_GEMINI_BACKUP=0          # 0 = never send chatbot data to Gemini when Ollama is off

# --- Backups when Gemini fails (on by default)
AI_FALLBACK=1                   # 0 = turn the automatic backups off
EVAL_PROVIDER=gemini            # ollama = always score offline
TRANSCRIBE_PROVIDER=gemini      # whisper = always transcribe offline (needs: pip install faster-whisper)
WHISPER_MODEL=base              # tiny / base / small

# --- Only when served over HTTPS
# SESSION_COOKIE_SECURE=1

# --- Panel revisions (all optional; these are the defaults)
# ADAPTIVE_INTERVIEW=1          # 1 = conversation: asks your name first, then writes each next question from your answers
                                # 0 = a fixed list of questions prepared at the start
# QUESTION_MODE=live            # only with ADAPTIVE_INTERVIEW=0: live = AI writes the list for the target job; bank = bank only
# LIVE_TIMEOUT_SECONDS=40       # longest the student waits for the interviewer before the backup is used
# LIVE_THINKING=minimal         # minimal = fast replies; low = better questions but slower
